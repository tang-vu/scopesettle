{
  "name": "@scopesettle/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "scopesettle": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "cli": "node dist/cli.js",
    "lint": "eslint src test build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@scopesettle/shared": "workspace:*",
    "viem": "2.57.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.19.2",
    "esbuild": "0.28.2",
    "eslint": "^9.39.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.5"
  }
}
